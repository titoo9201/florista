# Website (frontend) environment — copy to .env.local for local development.
# Everything here is bundled into the public JavaScript, so ONLY non-secret values belong here.
# Email keys, the WhatsApp number and the admin passkey live in server/.env (the API).

# Address of the Florista API (Render Web Service), e.g. https://florista-api.onrender.com
VITE_API_URL=
