# Copy this file to server/.env for local development (never commit .env).
# On Render, add the same keys under Environment → Environment Variables.

# MongoDB Atlas connection string (Atlas → Connect → Drivers).
# URL-encode special characters in the password (for example @ becomes %40).
MONGODB_URI=
MONGODB_DB=

# MASTER passkey (asked after tapping the logo 4 times on the Home page). It ALWAYS works and can only be
# changed here by the developer. The admin can also set their own passkey in the panel (Security tab) —
# both passkeys work at the same time; the admin panel can never remove or replace this master passkey.
ADMIN_PASSKEY=
# Remove the admin's own passkey (e.g. if it leaked): set to 1, redeploy, then delete this line again.
# The master passkey above is not affected.
# ADMIN_PASSKEY_RESET=1

# Long random string used to sign admin sessions (any 40+ random characters)
TOKEN_SECRET=

# Port (Render sets this automatically — leave empty there)
PORT=

# Website address(es) allowed to call this API, comma separated
# e.g. https://florista.onrender.com,http://localhost:5173
ALLOWED_ORIGINS=

# ---- Enquiry form emails (sent from this server through EmailJS) ----
# EmailJS → Email Services (service id), Email Templates → "Contact Us" (template id),
# Account → General / API keys (public key + PRIVATE key). Keep the private key secret.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional: a 2nd EmailJS template for emails TO the customer (automatic thank-you + the admin's reply
# templates in the dashboard). In EmailJS that template has: Subject {{subject}}, To Email {{to_email}},
# Reply To {{reply_to}}, From Name Florista, and the content (code editor) is only {{{message_html}}}.
# When this is set, turn OFF the Auto-Reply on the "Contact Us" template, or customers get two thank-yous.
EMAILJS_CUSTOMER_TEMPLATE_ID=
# Shop inbox: receives every enquiry, shown on the website, and used as Reply-To on customer emails.
# Only the developer can change it (the admin panel cannot).
ENQUIRY_TO_EMAIL=

# ---- WhatsApp ----
# Default number (country code + number, digits only, e.g. 919876543210) until the admin sets one in the panel
WHATSAPP_NUMBER=
